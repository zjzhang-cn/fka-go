# 拷贝成 .env 后填。**文件名必须正好是 .env，且与二进制同一套安装根下。**
#
# 安装根 = FKA_HOME；**不设时取可执行文件所在目录**。
# `data/`、`logs/`、`.env`、`mcp.json`、`skills/` 全都按它解析——所以别在任意 cwd
# 下找这些文件。
#
# ⚠️ 直接跑 `./bin/fka` 时安装根是 `bin/`，于是它读 `bin/.env` 与 `bin/skills/`。
#    而 `make serve` 把 FKA_HOME 设成仓库根，读的是仓库根下的那些。
#    **两种跑法读的不是同一份配置**——`make help` 第一行会打印当前实际值。

# ── 模型（必填）──────────────────────────────────────────
#
# 兼容任何 OpenAI 协议的服务。缺了 key 或 model 时 ask 与问答都会**明确报错**，
# 不会静默降级成空答案。
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=            # 不填用服务默认
# LLM_CONTEXT_TOKENS=128000 # 0 = 不设上限
# LLM_TIMEOUT_MS=120000    # 整体超时，从发请求起算，不重置
# LLM_STREAM_TIMEOUT_MS=10000  # 断流超时，每收一块重置
# LLM_SHOW_REASONING=0     # 关掉前台打印推理内容
# LLM_EXTRA_BODY_JSON={"reasoning_effort":"high"}  # **整份替换**请求体外层字段，
#                                                     # 不是深合并；`{}` = 什么都不并

# ── 工具循环 ────────────────────────────────────────────
#
# LLM_TOOLS 关掉的是整个工具循环（退回单发问答）：
# off / 0 / false / no。
# LLM_MAX_STEPS 是**硬上限**，到顶后不再给工具，改成无工具再问一次把已有
# 结果收拢成答案；那一次也失败才回兜底话术。越界夹到 999，0 或非法退回 5。
# LLM_TOOLS=off
# LLM_MAX_STEPS=5

# ── 工具放行（默认只放行 read）──────────────────────────
#
# 五类：read / memory / send / delete / external。
# **MCP 工具一律是 external**——要用记忆或文档 server 必须显式加上：
#
#     LLM_TOOL_EFFECTS=read,external
LLM_TOOL_EFFECTS=read

# ── iLink（微信）账号 ───────────────────────────────────
#
# **不要手填。** 跑 `fka login` 扫码，它会自己写下面这几行（文件权限 0600）。
#
# 槽位从 1 开始，登录时挑**第一个空槽**；`--account 2` 可以指定。
# 中间留空洞是允许的——删掉一个账号不必重排剩下的。
#
# ILINK_ACCOUNT_1_ID=account_001
# ILINK_ACCOUNT_1_BOT_TOKEN=
# ILINK_ACCOUNT_1_BASE_URL=https://ilinkai.weixin.qq.com
# ILINK_ACCOUNT_1_BOT_ID=
# ILINK_ACCOUNT_1_USER_ID=

# ── 日志与历史 ──────────────────────────────────────────
#
# LOG_LEVEL 是**控制台**级别（debug/info/warn/error/critical），
# 默认 warn。日志文件那一侧始终全量，一行不落——文件是排查用的，
# 不该因为控制台调静音而丢信息。控制台一律走 stderr。
# LOG_LEVEL=info
#
# SESSION_HISTORY=0 关掉会话历史（0 / off / false / no）。默认开。
# SESSION_HISTORY=0

# ── 技能 ────────────────────────────────────────────────
#
# 技能是 `<安装根>/skills/<名字>/SKILL.md`。改完不用重启。
# `skills__list` / `skills__load` **无条件注册**，所以目录空时它们也在：
# list 返 `[]`（正常状态，不是没装好），load 会告诉你该放哪。
# FKA_SKILLS_DIR 可以给多个目录（用系统路径分隔符 `:` 隔开），
# **同名技能后者覆盖前者**——用户目录因此能顶掉安装自带的。
# FKA_SKILLS_DIR=

# ── MCP ─────────────────────────────────────────────────
#
# 配置文件是 `<安装根>/mcp.json`（**可能含密钥，不入库**）。
# FKA_MCP_CONFIG 可覆盖路径，相对路径按安装根解析。
# FKA_MCP_CONFIG=
#
# 记忆 server 挂在上面那样：
# {
#   "mcpServers": {
#     "memory": {
#       "command": "/path/to/bin/fka-memory",
#       "args": ["--db", "/path/to/data/memory.sqlite"]
#     }
#   }
# }
#
# **它默认建自己的库**：`<安装根>/data/memory.sqlite`。
# 指到别的文件（含旧的共享 db.sqlite）也照样能用——认领路径只核对 memories
# 一张表，别的表一概忽略。
#
# 它自己那侧认两个变量：DB_PATH 改库位置（优先级 `--db` 参数 > 它 > 默认），
# 一律转成绝对路径——相对路径会按子进程 cwd 解析，同一份 mcp.json 在不同
# 机器上会指向不同的库，**而且不报错**。FKA_LOG_DIR 改它的日志目录，
# 都没有时落到临时目录而不是静默丢弃（它是 stdio 子进程，用户不会单独配）。
# DB_PATH=
# FKA_LOG_DIR=

# ── 命令行那几项（平时不用设）────────────────────────────
#
# FKA_SESSION / FKA_PRINCIPAL 是 --session / --principal 的环境变量版。
# **FKA_SESSION 不设时每次 ask 都新生成一个会话**——这是刻意的：历史按会话
# 落文件，用固定名会让「问音乐商店销量」之后再问天气时把上一个问题当上下文，
# 而命令行里什么都没变。想连续会话就显式给 --session。
#
# FKA_DEBUG=1 在 stderr 印 session / steps / stoppedBy / tools。
# FKA_COLOR 强制开或关颜色（always / never）；都不设时依次看 NO_COLOR、
# TERM=dumb、输出是不是终端。
# FKA_DEBUG=1
# FKA_COLOR=never
